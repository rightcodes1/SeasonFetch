# Local application defaults and non-secret provider URLs.
PORT=3000
CLIENT_ORIGIN=http://localhost:3000
CINEMETA_BASE_URL=https://v3-cinemeta.strem.io
TORRENTIO_BASE_URL=https://torrentio.strem.fun

# Supabase browser configuration: use only the public anon/publishable key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-or-publishable-key

# Optional server Supabase settings; server code falls back to the VITE_ values above.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-public-anon-or-publishable-key

# Optional server-only Gemini integration. Keep real values out of source control.
GEMINI_API_KEY=
GEMINI_MODEL=

# Optional intelligence mode: javascript, wasm-shadow, or wasm.
SEASONFETCH_INTELLIGENCE_MODE=javascript
