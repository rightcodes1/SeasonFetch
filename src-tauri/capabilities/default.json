{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for the SeasonFetch desktop window.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    {
      "identifier": "http:default",
      "allow": [{ "url": "https://season-fetch.vercel.app/**" }]
    }
  ]
}
