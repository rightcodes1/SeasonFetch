{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seasonfetch.local/contracts/intelligence-v1.schema.json",
  "title": "SeasonFetch Intelligence Contract v1",
  "type": "object",
  "required": ["contractVersion", "request", "candidates"],
  "additionalProperties": false,
  "properties": {
    "contractVersion": { "const": "seasonfetch.intelligence.v1" },
    "request": {
      "type": "object",
      "required": ["season", "episode", "profile", "audioMode", "filters"],
      "properties": {
        "season": { "type": ["integer", "null"], "minimum": 0 },
        "episode": { "type": ["integer", "null"], "minimum": 1 },
        "profile": { "enum": ["best-overall", "smallest-acceptable", "highest-quality", "most-reliable"] },
        "audioMode": { "enum": ["any", "english-dubbed-only", "english-dubbed-or-dual"] },
        "filters": {
          "type": "object",
          "required": ["resolution", "maxSizeBytes", "minSeeders", "codec", "hdr"],
          "properties": {
            "resolution": { "enum": ["any", "480p", "576p", "720p", "1080p", "1440p", "2160p", null] },
            "maxSizeBytes": { "type": ["integer", "null"], "minimum": 1 },
            "minSeeders": { "type": ["integer", "null"], "minimum": 0 },
            "codec": { "enum": ["H.264", "HEVC", "AV1", null] },
            "hdr": { "enum": ["HDR", "Dolby Vision", null] }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "candidates": {
      "type": "array",
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/candidate" }
    }
  },
  "$defs": {
    "candidate": {
      "type": "object",
      "required": ["id", "title", "infoHash", "fileIdx", "resolution", "codec", "hdr", "container", "sizeBytes", "seeders", "provider", "releaseType", "releaseGroup", "metadataCompleteness", "audio"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "title": { "type": "string", "maxLength": 2000 },
        "infoHash": { "anyOf": [{ "type": "string", "pattern": "^[0-9a-f]{40}$" }, { "type": "null" }] },
        "fileIdx": { "type": ["integer", "null"], "minimum": 0 },
        "resolution": { "enum": ["480p", "576p", "720p", "1080p", "1440p", "2160p", null] },
        "codec": { "enum": ["H.264", "HEVC", "AV1", null] },
        "hdr": { "enum": ["HDR", "Dolby Vision", null] },
        "container": { "type": ["string", "null"], "maxLength": 32 },
        "sizeBytes": { "type": ["integer", "null"], "minimum": 0 },
        "seeders": { "type": ["integer", "null"], "minimum": 0 },
        "provider": { "type": ["string", "null"], "maxLength": 128 },
        "releaseType": { "type": ["string", "null"], "maxLength": 64 },
        "releaseGroup": { "type": ["string", "null"], "maxLength": 128 },
        "metadataCompleteness": { "type": "integer", "minimum": 0, "maximum": 7 },
        "audio": {
          "type": "object",
          "required": ["classification", "languages", "confidence", "evidence"],
          "properties": {
            "classification": { "enum": ["explicit-english-dub", "possible-english-audio", "unverified"] },
            "languages": { "type": "array", "maxItems": 16, "items": { "type": "string", "maxLength": 16 } },
            "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
            "evidence": { "type": "array", "maxItems": 16, "items": { "type": "string", "maxLength": 128 } }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
